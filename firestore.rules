rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================
    // AUTHENTICATION
    // ==============================

    function signedIn() {
      return request.auth != null;
    }

    // ==============================
    // ROLES
    // ==============================

    function isCustomer() {
      return signedIn()
        && request.auth.token.role == "customer";
    }

    function isDriver() {
      return signedIn()
        && request.auth.token.role == "driver";
    }

    function isSupervisor() {
      return signedIn()
        && request.auth.token.role == "supervisor";
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.role == "admin";
    }

    function isOperations() {
      return signedIn()
        && request.auth.token.role in ["supervisor", "admin"];
    }

    // ==============================
    // USERS
    // ==============================

    match /users/{userId} {

      // Users can read themselves.
      // Supervisor/Admin can read operational users.
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isOperations()
        );

      // New users can create only their own
      // customer account.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "customer";

      // User can update their own profile,
      // but cannot change their role.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;

      // Supervisor/Admin can update users.
      allow update: if isOperations();

      // Only Admin can delete users.
      allow delete: if isAdmin();
    }

    // ==============================
    // ORDERS
    // ==============================

    match /orders/{orderId} {

      // Customer creates their own order.
      allow create: if isCustomer()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.paymentMethod == "cash";

      // Customer sees own orders.
      // Driver sees assigned orders.
      // Supervisor/Admin see all orders.
      allow read: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
          || isOperations()
        );

      // Driver can update an assigned order.
      allow update: if isDriver()
        && resource.data.driverId == request.auth.uid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.fee == resource.data.fee;

      // Supervisor/Admin can manage orders.
      allow update: if isOperations();

      // Only Admin can delete an order.
      allow delete: if isAdmin();
    }

    // ==============================
    // CASH COLLECTIONS
    // ==============================

    match /cashCollections/{collectionId} {

      // Driver records their own cash collection.
      allow create: if isDriver()
        && request.resource.data.driverId == request.auth.uid;

      // Driver sees own collections.
      // Supervisor/Admin see all.
      allow read: if signedIn()
        && (
          (
            isDriver()
            && resource.data.driverId == request.auth.uid
          )
          || isOperations()
        );

      // Supervisor/Admin reconcile cash.
      allow update: if isOperations();

      // Only Admin can delete.
      allow delete: if isAdmin();
    }

    // ==============================
    // AUDIT LOGS
    // ==============================

    match /auditLogs/{logId} {

      // Supervisor/Admin can view audit logs.
      allow read: if isOperations();

      // Only Admin can create/update/delete.
      allow create, update, delete: if isAdmin();
    }

    // ==============================
    // DEFAULT DENY
    // ==============================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
